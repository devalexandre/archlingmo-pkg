# Maintainer: Intro <intro-iu@outlook.com>
pkgname=lingmo-settings
arch=("x86_64")
depends=(
    "qt5-base" "qt5-quickcontrols2" "qt5-x11extras" "freetype2"
    "fontconfig" "networkmanager-qt" "modemmanager-qt" "libqtxdg" 
    "icu"
)
makedepends=("cmake" "extra-cmake-modules" "make" "gcc" "pkgconf")
pkgdesc="The system settings application for LingmoOS uses LingmoUI as the interface style."
pkgrel=1
pkgver=2.1.5
_realver=2.1.5+backport1
url="https://git.lingmo.org/SystemApps"
license=("GPL")
source=("https://github.com/LingmoOS/${pkgname}/archive/refs/tags/${_realver}.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/lingmo-settings-2.1.5-backport1"
}

build() {
  echo "Compiling $pkgname"
  mkdir -pv "$srcdir/lingmo-settings-2.1.5-backport1/build" && cd "$srcdir/lingmo-settings-2.1.5-backport1/build"
  cmake -DCMAKE_INSTALL_PREFIX=/usr ..
  
  # Add icu to the link.txt file
  find . -name "link.txt" | xargs sed -i 's|$| -licuuc|g'
  
  make -j$(nproc) || return 1
}

package() {
    mkdir -pv "$pkgdir"
    cd "$srcdir/lingmo-settings-2.1.5-backport1/build"
    make DESTDIR="$pkgdir" install
}